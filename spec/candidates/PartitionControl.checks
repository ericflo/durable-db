# kind config log-tag heap expected-counterexample
safe PartitionControl.cfg partition-control 2g -
safe PartitionControlRepeated.cfg partition-control-repeated 2g -
safe PartitionControlRenewal.cfg partition-control-renewal 2g -
safe PartitionControlRecovery.cfg partition-control-recovery 2g -
unsafe PartitionControlUnsafeAssignment.cfg partition-control-assignment 2g PartitionExclusive
unsafe PartitionControlUnsafeDrain.cfg partition-control-drain 2g PartitionExclusive
unsafe PartitionControlUnsafeReply.cfg partition-control-reply 2g OwnerWithinRoot
# Reachability controls, not unsafe protocol variants.
unsafe PartitionControlCoverage.cfg partition-control-coverage 2g NotIndependentMove
unsafe PartitionControlRecoveryCoverage.cfg partition-control-recovery-coverage 2g NotRecoveredMove
unsafe PartitionControlRepeatedCoverage.cfg partition-control-repeated-coverage 2g NotRepeatedMove
unsafe PartitionControlRenewalCoverage.cfg partition-control-renewal-coverage 2g NotRenewedOwnerMove
