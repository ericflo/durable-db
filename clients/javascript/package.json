{
  "name": "@durable-db/client",
  "version": "2.0.0",
  "private": true,
  "description": "TypeScript client for durable-db, with a pi-durable storage adapter",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "bench": "node bench/pi.ts",
    "typecheck": "tsc --project tsconfig.json && tsc --project ../../examples/web-app/tsconfig.json",
    "format": "prettier --config .prettierrc.json --write \"*.ts\" \"{src,test,bench}/**/*.ts\" \"../../examples/web-app/*.ts\"",
    "format:check": "prettier --config .prettierrc.json --check \"*.ts\" \"{src,test,bench}/**/*.ts\" \"../../examples/web-app/*.ts\""
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
